# Copy to .env and fill in.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/azi_db
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=60
INSTANCE_CODE=AZI

# --- Security (production) ---
# Comma-separated allowed browser origins (empty = none).
CORS_ORIGINS=
# Comma-separated allowed Host headers ("*" = any; restrict in production).
ALLOWED_HOSTS=*
